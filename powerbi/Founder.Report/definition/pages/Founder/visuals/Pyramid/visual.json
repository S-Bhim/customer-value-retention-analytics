{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.4.0/schema.json",
  "name": "Pyramid",
  "position": {
    "x": 20,
    "y": 145,
    "z": 0,
    "height": 360,
    "width": 690,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "barChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Customers"
                    }
                  },
                  "Property": "value_tier"
                }
              },
              "queryRef": "Customers.value_tier",
              "nativeQueryRef": "value_tier"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Customers"
                    }
                  },
                  "Property": "Customers"
                }
              },
              "queryRef": "Customers.Customers",
              "nativeQueryRef": "Customers"
            }
          ]
        },
        "Tooltips": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Customers"
                    }
                  },
                  "Property": "Observed sales USD"
                }
              },
              "queryRef": "Customers.Observed sales USD",
              "nativeQueryRef": "Observed sales USD"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Customers"
                    }
                  },
                  "Property": "Observed sales share"
                }
              },
              "queryRef": "Customers.Observed sales share",
              "nativeQueryRef": "Observed sales share"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Customers"
                    }
                  },
                  "Property": "Annual spend proxy USD"
                }
              },
              "queryRef": "Customers.Annual spend proxy USD",
              "nativeQueryRef": "Annual spend proxy USD"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'01 | Customer value pyramid'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "13D"
                }
              }
            }
          }
        }
      ],
      "subTitle": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Tiers use annual spend proxy; tooltips show recorded sales'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}