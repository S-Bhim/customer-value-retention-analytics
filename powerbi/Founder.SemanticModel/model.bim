        "partitions": [
          {
            "name": "Customers",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                " Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)), {\"customer_id\", \"age\", \"gender\", \"item_purchased\", \"category\", \"purchase_amount_usd\", \"state\", \"size\", \"color\", \"season\", \"review_rating\", \"subscription_status\", \"shipping_type\", \"discount_applied\", \"promo_code_used\", \"previous_purchases\", \"payment_method\", \"frequency_of_purchases\", \"annual_orders_proxy\", \"cadence_group\", \"promo_exposed\", \"subscriber\", \"dependency_score\", \"dependency_band\", \"satisfaction_flag\", \"satisfied\", \"annual_spend_proxy_usd\", \"historical_value_proxy_usd\", \"value_tier\", \"value_tier_order\", \"high_history\", \"loyalty_a\", \"loyalty_b\", \"history_band\", \"age_band\", \"segment\", \"sunset_eligible\", \"state_country\"}),",
                " Typed = Table.TransformColumnTypes(Source, {{\"customer_id\", Int64.Type}, {\"age\", Int64.Type}, {\"gender\", type text}, {\"item_purchased\", type text}, {\"category\", type text}, {\"purchase_amount_usd\", Int64.Type}, {\"state\", type text}, {\"size\", type text}, {\"color\", type text}, {\"season\", type text}, {\"review_rating\", type number}, {\"subscription_status\", type text}, {\"shipping_type\", type text}, {\"discount_applied\", type text}, {\"promo_code_used\", type text}, {\"previous_purchases\", Int64.Type}, {\"payment_method\", type text}, {\"frequency_of_purchases\", type text}, {\"annual_orders_proxy\", Int64.Type}, {\"cadence_group\", type text}, {\"promo_exposed\", Int64.Type}, {\"subscriber\", Int64.Type}, {\"dependency_score\", Int64.Type}, {\"dependency_band\", type text}, {\"satisfaction_flag\", type text}, {\"satisfied\", Int64.Type}, {\"annual_spend_proxy_usd\", Int64.Type}, {\"historical_value_proxy_usd\", Int64.Type}, {\"value_tier\", type text}, {\"value_tier_order\", Int64.Type}, {\"high_history\", Int64.Type}, {\"loyalty_a\", Int64.Type}, {\"loyalty_b\", Int64.Type}, {\"history_band\", type text}, {\"age_band\", type text}, {\"segment\", type text}, {\"sunset_eligible\", Int64.Type}, {\"state_country\", type text}}, \"en-US\")",
                "in Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Customers",
            "expression": "COUNTROWS(Customers)",
            "formatString": "#,0"
          },
          {
            "name": "Observed sales USD",
            "expression": "SUM(Customers[purchase_amount_usd])",
            "formatString": "$#,0"
          },
          {
            "name": "Average order USD",
            "expression": "DIVIDE([Observed sales USD], [Customers])",
            "formatString": "$0.00"
          },
          {
            "name": "Promo customer share",
            "expression": "AVERAGE(Customers[promo_exposed])",
            "formatString": "0.0%"
          },
          {
            "name": "Promo sales share",
            "expression": "DIVIDE(CALCULATE([Observed sales USD], Customers[promo_exposed] = 1), [Observed sales USD])",
            "formatString": "0.0%"
          },
          {
            "name": "Repeat cadence proxy",
            "expression": "AVERAGE(Customers[loyalty_a])",
            "formatString": "0.0%"
          },
          {
            "name": "High history share",
            "expression": "AVERAGE(Customers[high_history])",
            "formatString": "0.0%"
          },
          {
            "name": "Annual spend proxy USD",
            "expression": "SUM(Customers[annual_spend_proxy_usd])",
            "formatString": "$#,0"
          },
          {
            "name": "Observed sales share",
            "expression": "DIVIDE([Observed sales USD], CALCULATE([Observed sales USD], REMOVEFILTERS(Customers[value_tier])))",
            "formatString": "0.0%"
          },
          {
            "name": "Full price sales USD",
            "expression": "CALCULATE([Observed sales USD], Customers[promo_exposed] = 0)",
            "formatString": "$#,0"
          },
          {
            "name": "Full price spend per customer",
            "expression": "DIVIDE([Full price sales USD], [Customers])",
            "formatString": "$0.00"
          },
          {
            "name": "Smoothed full price spend",
            "expression": "DIVIDE([Full price sales USD] + 50 * CALCULATE([Full price spend per customer], REMOVEFILTERS(Customers[state_country])), [Customers] + 50)",
            "formatString": "$0.00"
          },
          {
            "name": "Sunset eligible customers",
            "expression": "SUM(Customers[sunset_eligible])",
            "formatString": "#,0"
          }
        ]
      }
    ],
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"Customers\"]"
      }
    ]
  }
}